# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT
JWT_SECRET=this_is_JWT_secret_of_trendora_backend
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=this_is_JWT_refresh_secret_of_trendora_backend
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=this_is_cookie_secret_of_trendora_backend

# MySQL (not connected yet — repositories currently return mock data.
# Fill these in and implement the TODOs in src/repositories/*.js when ready.)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=MyAppPass123
DB_NAME=trendora

# Bakong KHQR (real payment QR) — leave blank to disable; the Checkout page
# will show an error if the customer picks KHQR without these set.
# BAKONG_ACCOUNT_ID: your Bakong Account ID, e.g. "yourname@aclb" — get this
#   from your bank's Bakong-linked mobile app (Profile screen), or ask your
#   bank for a business/merchant KHQR account.
# BAKONG_DEV_TOKEN: register a developer account at
#   https://api-bakong.nbc.gov.kh and generate a Bearer token there. Tokens
#   expire periodically and need to be renewed.
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=Trendora
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_DEV_TOKEN=
